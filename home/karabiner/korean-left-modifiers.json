{
    "description": "Make left modifiers(control, option, command) key work in Korean mode",
    "manipulators": [
        {
            "conditions": [
                {
                    "input_sources": [
                        {
                            "input_source_id": "^com\\.apple\\.inputmethod\\.Korean\\.2SetKorean$",
                            "language": "^ko$"
                        }
                    ],
                    "type": "input_source_if"
                }
            ],
            "from": {
                "key_code": "left_control",
                "modifiers": { "optional": ["any"] }
            },
            "to": [
                { "select_input_source": { "language": "^en$" } },
                { "key_code": "left_control" }
            ],
            "to_after_key_up": [
                {
                    "select_input_source": {
                        "input_source_id": "^com\\.apple\\.inputmethod\\.Korean\\.2SetKorean$",
                        "language": "^ko$"
                    }
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "input_sources": [
                        {
                            "input_source_id": "^com\\.apple\\.inputmethod\\.Korean\\.2SetKorean$",
                            "language": "^ko$"
                        }
                    ],
                    "type": "input_source_if"
                }
            ],
            "from": {
                "key_code": "left_command",
                "modifiers": { "optional": ["any"] }
            },
            "to": [
                { "select_input_source": { "language": "^en$" } },
                { "key_code": "left_command" }
            ],
            "to_after_key_up": [
                {
                    "select_input_source": {
                        "input_source_id": "^com\\.apple\\.inputmethod\\.Korean\\.2SetKorean$",
                        "language": "^ko$"
                    }
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "input_sources": [
                        {
                            "input_source_id": "^com\\.apple\\.inputmethod\\.Korean\\.2SetKorean$",
                            "language": "^ko$"
                        }
                    ],
                    "type": "input_source_if"
                }
            ],
            "from": {
                "key_code": "left_option",
                "modifiers": { "optional": ["any"] }
            },
            "to": [
                { "select_input_source": { "language": "^en$" } },
                { "key_code": "left_option" }
            ],
            "to_after_key_up": [
                {
                    "select_input_source": {
                        "input_source_id": "^com\\.apple\\.inputmethod\\.Korean\\.2SetKorean$",
                        "language": "^ko$"
                    }
                }
            ],
            "type": "basic"
        }
    ]
}
